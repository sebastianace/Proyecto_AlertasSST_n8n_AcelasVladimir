# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a GitHub.

# Clave del usuario administrador de PostgreSQL (solo para instalar la base).
POSTGRES_PASSWORD=cambia_esta_clave

# Clave con la que n8n cifra sus credenciales. Usa una cadena larga y aleatoria.
N8N_ENCRYPTION_KEY=cambia_esto_por_una_cadena_larga_y_aleatoria

# Clave del rol n8n_alertas (el que usa n8n para conectarse a la base).
N8N_ALERTAS_CLAVE=cambia_esta_otra_clave
